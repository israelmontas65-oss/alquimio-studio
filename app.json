{
  "expo": {
    "name": "Alquimio",
    "slug": "alquimio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alquimio",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alquimio.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Alquimio necesita acceso a tu galería para seleccionar fotos y videos.",
        "NSCameraUsageDescription": "Alquimio necesita acceso a tu cámara para capturar contenido.",
        "NSMicrophoneUsageDescription": "Alquimio necesita acceso al micrófono para grabar videos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#080C14"
      },
      "package": "com.israelmontas.alquimio",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Alquimio",
      "shortName": "Alquimio",
      "display": "standalone",
      "backgroundColor": "#080C14",
      "themeColor": "#080C14",
      "lang": "es",
      "scope": "/",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Alquimio necesita acceso a tu galería.",
          "cameraPermission": "Alquimio necesita acceso a tu cámara."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
