# ============================================================
# ALQUIMIA STUDIO - Variables de Entorno (Plantilla)
# Copia este archivo a .env.local para desarrollo local
# ============================================================

# ── TikTok for Developers (API v2) ────────────────────────────
# Obtenidos en https://developers.tiktok.com/
EXPO_PUBLIC_TIKTOK_CLIENT_KEY=tu_tiktok_client_key
EXPO_PUBLIC_TIKTOK_CLIENT_SECRET=tu_tiktok_client_secret

# URI de redirección registrada en TikTok Developer Portal
# En producción Cloudflare Pages:
EXPO_PUBLIC_TIKTOK_REDIRECT_URI=https://alquimia-studio.pages.dev/oauth/tiktok
# En desarrollo local:
# EXPO_PUBLIC_TIKTOK_REDIRECT_URI=http://localhost:8081/oauth/tiktok

# ── Despliegue Cloudflare Pages ───────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
